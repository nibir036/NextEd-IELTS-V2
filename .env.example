# GEMINI_API_KEY: required for the /api/writing/evaluate route
# (server-side only, never exposed to the browser).
GEMINI_API_KEY="your-gemini-api-key"

# SPEAKING_API_BASE_URL / SPEAKING_API_KEY: the FastAPI + RunPod speaking
# evaluation service (see NextED_IELTS_Speaking repo). /api/speaking/evaluate
# calls this instead of Gemini directly.
#   - SPEAKING_API_BASE_URL: e.g. http://localhost:8000 in dev.
#   - SPEAKING_API_KEY: must match INTERNAL_API_KEY in that service's .env.
SPEAKING_API_BASE_URL="http://localhost:8000"
SPEAKING_API_KEY="your-shared-secret"

# ALPHA_SMS_API_KEY: Alpha SMS BD (api.sms.net.bd) API key, used by
# src/lib/sms.ts to text the signup phone-verification OTP. Generate one
# from the "API" page of the sms.net.bd dashboard.
ALPHA_SMS_API_KEY="your-alpha-sms-api-key"

NEXT_PUBLIC_META_PIXEL_ID=YOUR_PIXEL_ID
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
META_CAPI_ACCESS_TOKEN=EAAB...your token...
META_TEST_EVENT_CODE=TEST12345

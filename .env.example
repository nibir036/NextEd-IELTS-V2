# GEMINI_API_KEY: required for the /api/writing/evaluate route
# (server-side only, never exposed to the browser).
GEMINI_API_KEY="your-gemini-api-key"

# SPEAKING_API_BASE_URL / SPEAKING_API_KEY: the FastAPI + RunPod speaking
# evaluation service (see NextED_IELTS_Speaking repo). /api/speaking/evaluate
# calls this instead of Gemini directly.
#   - SPEAKING_API_BASE_URL: e.g. http://localhost:8000 in dev.
#   - SPEAKING_API_KEY: must match INTERNAL_API_KEY in that service's .env.
SPEAKING_API_BASE_URL="http://localhost:8000"
SPEAKING_API_KEY="your-shared-secret"

# ALPHA_SMS_API_KEY: Alpha SMS BD (api.sms.net.bd) API key, used by
# src/lib/sms.ts to text the signup phone-verification OTP. Generate one
# from the "API" page of the sms.net.bd dashboard.
ALPHA_SMS_API_KEY="your-alpha-sms-api-key"

# NEXT_PUBLIC_META_PIXEL_ID: Meta (Facebook/Instagram) ad Pixel/dataset ID
# from Meta Events Manager -> Datasets and pixels. NEXT_PUBLIC_ prefix is
# intentional -- this is read client-side (src/app/layout.tsx) to load the
# base Pixel script; it's not sensitive (visible in any browser's network
# tab regardless).
NEXT_PUBLIC_META_PIXEL_ID="your-meta-pixel-id"

# META_CAPI_ACCESS_TOKEN: server-only Conversions API access token for the
# SAME dataset as NEXT_PUBLIC_META_PIXEL_ID above (Events Manager -> that
# dataset -> Settings -> Conversions API -> Generate access token). Used
# server-side to send matching CompleteRegistration events on signup.
# Never expose this one to the browser.
META_CAPI_ACCESS_TOKEN="your-conversions-api-access-token"

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model knowledge {
  id         String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  content    String
  embedding  Unsupported("vector")?
  metadata   Json?
  created_at DateTime               @default(now()) @db.Timestamptz(6)

  @@index([embedding], map: "idx_knowledge_embedding")
}

model learning_paths {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String
  title      String?
  plan       Json
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_learning_paths_user")
}

model lesson_resources {
  id        String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  lesson_id String  @db.Uuid
  kind      String?
  url       String
  title     String?
  position  Int     @default(0)
  lessons   lessons @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([lesson_id], map: "idx_lesson_resources_lesson")
}

model lessons {
  id               String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  section          lesson_section
  title            String
  body             String?
  difficulty       Int?               @db.SmallInt
  position         Int                @default(0)
  is_published     Boolean            @default(true)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  lesson_resources lesson_resources[]

  @@index([section], map: "idx_lessons_section")
}

model mock_test_sections {
  mock_test_id String     @db.Uuid
  test_id      String     @db.Uuid
  position     Int        @default(0)
  mock_tests   mock_tests @relation(fields: [mock_test_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tests        tests      @relation(fields: [test_id], references: [id], onUpdate: NoAction)

  @@id([mock_test_id, test_id])
  @@index([mock_test_id], map: "idx_mock_sections_mock")
}

model mock_tests {
  id                 String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title              String
  description        String?
  is_published       Boolean              @default(true)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  mock_test_sections mock_test_sections[]
  submissions        submissions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model submissions {
  id           String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String
  kind         submission_kind   @default(single_test)
  test_id      String?           @db.Uuid
  mock_test_id String?           @db.Uuid
  skill        skill_type?
  status       submission_status @default(pending)
  band_score   Decimal?          @db.Decimal(2, 1)
  feedback     Json?
  answers      Json?
  submitted_at DateTime          @default(now()) @db.Timestamptz(6)
  scored_at    DateTime?         @db.Timestamptz(6)
  mock_tests   mock_tests?       @relation(fields: [mock_test_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  tests        tests?            @relation(fields: [test_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  users        users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, test_id], map: "uniq_submission_user_test", where: raw("(test_id IS NOT NULL)"))
  @@index([mock_test_id], map: "idx_submissions_mock")
  @@index([test_id], map: "idx_submissions_test")
  @@index([user_id], map: "idx_submissions_user")
}

model test_resources {
  id       String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  test_id  String  @db.Uuid
  kind     String?
  url      String?
  content  String?
  position Int     @default(0)
  tests    tests   @relation(fields: [test_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([test_id], map: "idx_test_resources_test")
}

model tests {
  id                 String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  skill              skill_type
  title              String
  description        String?
  instructions       String?
  band_target        Decimal?             @db.Decimal(2, 1)
  duration_seconds   Int?
  position           Int                  @default(0)
  is_published       Boolean              @default(true)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  mock_test_sections mock_test_sections[]
  submissions        submissions[]
  test_resources     test_resources[]
  test_sections      test_sections[]
  test_attempts      test_attempts[]

  @@index([skill], map: "idx_tests_skill")
}

model test_sections {
  id           String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  test_id      String           @db.Uuid
  position     Int              @default(0)
  title        String?
  instructions String?
  audio_url    String?
  image_url    String?
  passage_text String?
  created_at   DateTime         @default(now()) @db.Timestamptz(6)
  tests        tests            @relation(fields: [test_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  questions    test_questions[]

  @@index([test_id], map: "idx_test_sections_test")
}

model test_questions {
  id         String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  section_id String        @db.Uuid
  qnumber    Int
  position   Int           @default(0)
  type       question_type
  prompt     String?
  options    Json?
  max_words  Int?
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  section    test_sections @relation(fields: [section_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  answer     test_answers?

  @@index([section_id], map: "idx_test_questions_section")
}

model test_answers {
  id          String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  question_id String         @unique @db.Uuid
  accepted    Json           @default("[]")
  points      Int            @default(1)
  question    test_questions @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model test_attempts {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String
  test_id      String   @db.Uuid
  raw_score    Int?
  total        Int?
  band         Decimal? @db.Decimal(2, 1)
  answers      Json     @default("{}")
  submitted_at DateTime @default(now()) @db.Timestamptz(6)
  tests        tests    @relation(fields: [test_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_test_attempts_user")
  @@index([test_id], map: "idx_test_attempts_test")
}

model uploads {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  storage_path String
  file_name    String?
  mime_type    String?
  size_bytes   BigInt?
  uploaded_by  String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  users        users?   @relation(fields: [uploaded_by], references: [id], onUpdate: NoAction)
}

model user_skill_bands {
  user_id    String
  skill      skill_type
  band       Decimal?   @db.Decimal(2, 1)
  updated_at DateTime   @default(now()) @db.Timestamptz(6)
  users      users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, skill])
}

// ── Grammar engine (Zero to Band 9) ─────────────────────────────────

model grammar_modules {
  id           String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug         String             @unique
  title        String
  subtitle     String?
  band_unlock  String?
  description  String?
  position     Int                @default(0)
  is_published Boolean            @default(false)
  created_at   DateTime           @default(now()) @db.Timestamptz(6)
  updated_at   DateTime           @default(now()) @db.Timestamptz(6)
  chapters     grammar_chapters[]
}

model grammar_chapters {
  id            String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  module_id     String                  @db.Uuid
  slug          String
  title         String
  position      Int                     @default(0)
  estimated_min Int?
  difficulty    Int?                    @db.SmallInt
  band_target   String?
  summary       String?
  content       Json                    @default("{\"version\":1,\"blocks\":[]}")
  is_published  Boolean                 @default(false)
  created_at    DateTime                @default(now()) @db.Timestamptz(6)
  updated_at    DateTime                @default(now()) @db.Timestamptz(6)
  module        grammar_modules         @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exercises     grammar_exercises[]
  progress      user_grammar_progress[]

  @@unique([module_id, slug])
  @@index([module_id, position], map: "idx_grammar_chapters_module")
}

model grammar_exercises {
  id           String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  chapter_id   String                 @db.Uuid
  slug         String
  title        String
  kind         grammar_exercise_kind
  instructions String?
  items        Json                   @default("[]")
  position     Int                    @default(0)
  is_published Boolean                @default(true)
  created_at   DateTime               @default(now()) @db.Timestamptz(6)
  chapter      grammar_chapters       @relation(fields: [chapter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attempts     user_grammar_attempts[]

  @@unique([chapter_id, slug])
  @@index([chapter_id, position], map: "idx_grammar_exercises_chapter")
}

model user_grammar_progress {
  id            String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id       String
  chapter_id    String           @db.Uuid
  status        String           @default("not_started")
  started_at    DateTime?        @db.Timestamptz(6)
  completed_at  DateTime?        @db.Timestamptz(6)
  last_position String?
  updated_at    DateTime         @default(now()) @db.Timestamptz(6)
  chapter       grammar_chapters @relation(fields: [chapter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, chapter_id])
  @@index([user_id], map: "idx_user_grammar_progress_user")
}

model user_grammar_attempts {
  id           String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String
  exercise_id  String            @db.Uuid
  answers      Json              @default("{}")
  score        Int?
  max_score    Int?
  feedback     Json?
  completed_at DateTime          @default(now()) @db.Timestamptz(6)
  exercise     grammar_exercises @relation(fields: [exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, exercise_id], map: "idx_user_grammar_attempts_user_ex")
}

model users {
  id                  String               @id
  email               String?              @unique
  display_name        String?
  photo_url           String?
  native_language     String?
  role                user_role            @default(student)
  target_band         Decimal?             @db.Decimal(2, 1)
  overall_band        Decimal?             @db.Decimal(2, 1)
  total_practice_time Int                  @default(0)
  onboarding_complete Boolean              @default(false)
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime             @default(now()) @db.Timestamptz(6)
  last_active_at      DateTime?            @db.Timestamptz(6)
  phone               String?              @unique(map: "uniq_users_phone", where: raw("(phone IS NOT NULL)"))
  password_hash       String?
  is_phone_verified   Boolean              @default(false)
  exam_date           DateTime?            @db.Date
  avatar              String?
  legal_full_name     String?
  country             String?
  date_of_birth       DateTime?            @db.Date
  exam_type           exam_type?
  academic_background academic_background?
  has_taken_ielts     Boolean              @default(false)
  previous_ielts_year Int?                 @db.SmallInt
  previous_ielts_band Decimal?             @db.Decimal(2, 1)
  learning_paths      learning_paths[]
  submissions         submissions[]
  test_attempts       test_attempts[]
  uploads             uploads[]
  user_skill_bands    user_skill_bands[]
  user_grammar_progress user_grammar_progress[]
  user_grammar_attempts user_grammar_attempts[]
}

enum lesson_section {
  grammar
  vocab
  tips
}

enum exam_type {
  academic
  general_training
}

enum academic_background {
  ssc_olevels
  hsc_alevels
  diploma
  bachelors
  masters
  phd
  other
}

enum skill_type {
  listening
  reading
  writing
  speaking
}

enum question_type {
  text_input
  single_choice
  multi_choice
  matching
  map_label
}

enum submission_kind {
  single_test
  full_mock
}

enum submission_status {
  pending
  scoring
  scored
  failed
}

enum user_role {
  student
  admin
}

enum grammar_exercise_kind {
  identification
  correction
  essay_edit
  mcq
  production
  gap_fill
}

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// Append-only login log, one row per successful login -- backs the admin
// analytics page's day-by-day "logged in" trend. users.last_active_at only
// ever holds the single most recent login timestamp (overwritten every
// login), so it can't answer "how many users logged in on day X" for any
// day but the latest -- this table is the only accurate source, and only
// from the day it was created onward. Table itself is created by hand via
// scripts/add-login-events-table.sql (see that file for why), not by
// `prisma migrate` / `prisma db push` -- this model just mirrors it so the
// generated client exposes prisma.login_events.
model login_events {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_login_events_user")
  @@index([created_at], map: "idx_login_events_created_at")
}

model knowledge {
  id         String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  content    String
  embedding  Unsupported("vector")?
  metadata   Json?
  created_at DateTime               @default(now()) @db.Timestamptz(6)

  @@index([embedding], map: "idx_knowledge_embedding")
}

model learning_paths {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String
  title      String?
  plan       Json
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_learning_paths_user")
}

model lesson_resources {
  id        String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  lesson_id String  @db.Uuid
  kind      String?
  url       String
  title     String?
  position  Int     @default(0)
  lessons   lessons @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([lesson_id], map: "idx_lesson_resources_lesson")
}

model lessons {
  id               String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  section          lesson_section
  title            String
  body             String?
  difficulty       Int?               @db.SmallInt
  position         Int                @default(0)
  is_published     Boolean            @default(true)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  lesson_resources lesson_resources[]
  vocabularies     vocabulary[]
  vocab_lessons    vocab_lessons[]

  @@index([section], map: "idx_lessons_section")
}

// Bite-sized browsing layer for the "Zero to Band 9" vocab chapters --
// same architecture as tips_lessons / grammar_lessons, but the parent
// is a single `lessons` row (section = 'vocab', position 1-7) instead
// of a module/chapter pair, since Zero to Band 9 has no module concept.
// There is also no separate exercises table for vocab: chapters embed
// their own exercise blocks, so `exercise_anchor_block_id` points at a
// block inside the SAME chapter's content rather than a foreign row.
model vocab_lessons {
  id                        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  lesson_id                 String   @db.Uuid
  slug                      String
  position                  Int      @default(0)
  title                     String
  source_label              String?
  collection_slug           String?
  collection_label          String?
  bite                      String
  detail_md                 String
  read_more_anchor_block_id String?
  exercise_anchor_block_id  String?
  estimated_min             Int?
  is_published              Boolean  @default(true)
  created_at                DateTime @default(now()) @db.Timestamptz(6)
  updated_at                DateTime @default(now()) @db.Timestamptz(6)
  lesson                    lessons  @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([lesson_id, slug])
  @@index([lesson_id, position], map: "idx_vocab_lessons_lesson")
}

model mock_test_sections {
  mock_test_id String     @db.Uuid
  test_id      String     @db.Uuid
  position     Int        @default(0)
  mock_tests   mock_tests @relation(fields: [mock_test_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tests        tests      @relation(fields: [test_id], references: [id], onUpdate: NoAction)

  @@id([mock_test_id, test_id])
  @@index([mock_test_id], map: "idx_mock_sections_mock")
}

model mock_tests {
  id                 String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title              String
  description        String?
  is_published       Boolean              @default(true)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  mock_test_sections mock_test_sections[]
  submissions        submissions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model submissions {
  id           String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String
  kind         submission_kind   @default(single_test)
  test_id      String?           @db.Uuid
  mock_test_id String?           @db.Uuid
  skill        skill_type?
  status       submission_status @default(pending)
  band_score   Decimal?          @db.Decimal(2, 1)
  feedback     Json?
  answers      Json?
  submitted_at DateTime          @default(now()) @db.Timestamptz(6)
  scored_at    DateTime?         @db.Timestamptz(6)
  mock_tests   mock_tests?       @relation(fields: [mock_test_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  tests        tests?            @relation(fields: [test_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  users        users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Practice tests are meant to be retaken -- test_attempts (the
  // Listening/Reading equivalent of this table) has never had a unique
  // constraint here either. Real dev data already has a user with 6
  // separate scored speaking submissions against the same test_id, all
  // legitimate retries, which is why this was dropped rather than enforced.
  @@index([mock_test_id], map: "idx_submissions_mock")
  @@index([test_id], map: "idx_submissions_test")
  @@index([user_id], map: "idx_submissions_user")
}

model test_resources {
  id       String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  test_id  String  @db.Uuid
  kind     String?
  url      String?
  content  String?
  position Int     @default(0)
  tests    tests   @relation(fields: [test_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([test_id], map: "idx_test_resources_test")
}

model tests {
  id                 String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  skill              skill_type
  title              String
  description        String?
  instructions       String?
  band_target        Decimal?             @db.Decimal(2, 1)
  duration_seconds   Int?
  position           Int                  @default(0)
  is_published       Boolean              @default(true)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  mock_test_sections mock_test_sections[]
  submissions        submissions[]
  test_resources     test_resources[]
  test_sections      test_sections[]
  test_attempts      test_attempts[]

  @@index([skill], map: "idx_tests_skill")
}

model test_sections {
  id           String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  test_id      String           @db.Uuid
  position     Int              @default(0)
  title        String?
  instructions String?
  audio_url    String?
  image_url    String?
  passage_text String?
  created_at   DateTime         @default(now()) @db.Timestamptz(6)
  tests        tests            @relation(fields: [test_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  questions    test_questions[]

  @@index([test_id], map: "idx_test_sections_test")
}

model test_questions {
  id         String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  section_id String        @db.Uuid
  qnumber    Int
  position   Int           @default(0)
  type       question_type
  prompt     String?
  options    Json?
  max_words  Int?
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  section    test_sections @relation(fields: [section_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  answer     test_answers?

  @@index([section_id], map: "idx_test_questions_section")
}

model test_answers {
  id          String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  question_id String         @unique @db.Uuid
  accepted    Json           @default("[]")
  points      Int            @default(1)
  question    test_questions @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model test_attempts {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String
  test_id      String   @db.Uuid
  raw_score    Int?
  total        Int?
  band         Decimal? @db.Decimal(2, 1)
  answers      Json     @default("{}")
  submitted_at DateTime @default(now()) @db.Timestamptz(6)
  tests        tests    @relation(fields: [test_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_test_attempts_user")
  @@index([test_id], map: "idx_test_attempts_test")
}

model uploads {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  storage_path String
  file_name    String?
  mime_type    String?
  size_bytes   BigInt?
  uploaded_by  String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  users        users?   @relation(fields: [uploaded_by], references: [id], onUpdate: NoAction)
}

model user_skill_bands {
  user_id    String
  skill      skill_type
  band       Decimal?   @db.Decimal(2, 1)
  updated_at DateTime   @default(now()) @db.Timestamptz(6)
  users      users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, skill])
}

// ── Grammar engine (Zero to Band 9) ─────────────────────────────────

model grammar_modules {
  id           String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug         String             @unique
  title        String
  subtitle     String?
  band_unlock  String?
  description  String?
  position     Int                @default(0)
  is_published Boolean            @default(false)
  created_at   DateTime           @default(now()) @db.Timestamptz(6)
  updated_at   DateTime           @default(now()) @db.Timestamptz(6)
  chapters     grammar_chapters[]
  lessons      grammar_lessons[]
}

model grammar_chapters {
  id            String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  module_id     String                  @db.Uuid
  slug          String
  title         String
  position      Int                     @default(0)
  estimated_min Int?
  difficulty    Int?                    @db.SmallInt
  band_target   String?
  summary       String?
  content       Json                    @default("{\"version\":1,\"blocks\":[]}")
  is_published  Boolean                 @default(false)
  created_at    DateTime                @default(now()) @db.Timestamptz(6)
  updated_at    DateTime                @default(now()) @db.Timestamptz(6)
  module        grammar_modules         @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exercises     grammar_exercises[]
  progress      user_grammar_progress[]
  lessons       grammar_lessons[]

  @@unique([module_id, slug])
  @@index([module_id, position], map: "idx_grammar_chapters_module")
}

model grammar_exercises {
  id           String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  chapter_id   String                  @db.Uuid
  slug         String
  title        String
  kind         grammar_exercise_kind
  instructions String?
  items        Json                    @default("[]")
  position     Int                     @default(0)
  is_published Boolean                 @default(true)
  created_at   DateTime                @default(now()) @db.Timestamptz(6)
  chapter      grammar_chapters        @relation(fields: [chapter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attempts     user_grammar_attempts[]
  lessons      grammar_lessons[]

  @@unique([chapter_id, slug])
  @@index([chapter_id, position], map: "idx_grammar_exercises_chapter")
}

// Bite-sized "quick tip" layer for Grammar, mirroring tips_lessons --
// short teaser cards, grouped into collections, that sit in front of
// the full chapters. Unlike tips_lessons, each lesson can also point
// at a specific grammar_exercise, since Grammar (unlike the Tips
// modules) has real practice drills attached to its chapters -- the
// bite-lesson modal offers both "Read More" (full chapter, at
// read_more_anchor_block_id) and "Go to Exercises" (that exercise).
model grammar_lessons {
  id                        String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  module_id                 String             @db.Uuid
  chapter_id                String?            @db.Uuid
  exercise_id               String?            @db.Uuid
  slug                      String
  position                  Int                @default(0)
  title                     String
  source_label              String?
  collection_slug           String?
  collection_label          String?
  bite                      String
  detail_md                 String
  read_more_anchor_block_id String?
  estimated_min             Int?
  is_published               Boolean            @default(true)
  created_at                DateTime           @default(now()) @db.Timestamptz(6)
  updated_at                DateTime           @default(now()) @db.Timestamptz(6)
  module                    grammar_modules    @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chapter                   grammar_chapters?  @relation(fields: [chapter_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  exercise                  grammar_exercises? @relation(fields: [exercise_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([module_id, slug])
  @@index([module_id, position], map: "idx_grammar_lessons_module")
  @@index([module_id, collection_slug], map: "idx_grammar_lessons_collection")
}

model user_grammar_progress {
  id            String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id       String
  chapter_id    String           @db.Uuid
  status        String           @default("not_started")
  started_at    DateTime?        @db.Timestamptz(6)
  completed_at  DateTime?        @db.Timestamptz(6)
  last_position String?
  updated_at    DateTime         @default(now()) @db.Timestamptz(6)
  chapter       grammar_chapters @relation(fields: [chapter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, chapter_id])
  @@index([user_id], map: "idx_user_grammar_progress_user")
}

model user_grammar_attempts {
  id           String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String
  exercise_id  String            @db.Uuid
  answers      Json              @default("{}")
  score        Int?
  max_score    Int?
  feedback     Json?
  completed_at DateTime          @default(now()) @db.Timestamptz(6)
  exercise     grammar_exercises @relation(fields: [exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, exercise_id], map: "idx_user_grammar_attempts_user_ex")
}

model tips_modules {
  id           String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  skill        String         @default("writing")
  slug         String         @unique
  title        String
  subtitle     String?
  description  String?
  position     Int            @default(0)
  is_published Boolean        @default(false)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @default(now()) @db.Timestamptz(6)
  chapters     tips_chapters[]
  lessons      tips_lessons[]

  @@index([skill, position], map: "idx_tips_modules_skill")
}

model tips_chapters {
  id            String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  module_id     String              @db.Uuid
  slug          String
  title         String
  position      Int                 @default(0)
  estimated_min Int?
  summary       String?
  content       Json                @default("{\"version\":1,\"blocks\":[]}")
  is_published  Boolean             @default(false)
  created_at    DateTime            @default(now()) @db.Timestamptz(6)
  updated_at    DateTime            @default(now()) @db.Timestamptz(6)
  module        tips_modules        @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  progress      user_tips_progress[]
  lessons       tips_lessons[]

  @@unique([module_id, slug])
  @@index([module_id, position], map: "idx_tips_chapters_module")
}

model tips_lessons {
  id                        String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  module_id                 String        @db.Uuid
  chapter_id                String?       @db.Uuid
  slug                      String
  position                  Int           @default(0)
  title                     String
  source_label              String?
  collection_slug           String?
  collection_label          String?
  bite                      String
  detail_md                 String
  read_more_anchor_block_id String?
  estimated_min             Int?
  is_published               Boolean       @default(true)
  created_at                DateTime      @default(now()) @db.Timestamptz(6)
  updated_at                DateTime      @default(now()) @db.Timestamptz(6)
  module                    tips_modules  @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chapter                   tips_chapters? @relation(fields: [chapter_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([module_id, slug])
  @@index([module_id, position], map: "idx_tips_lessons_module")
  @@index([module_id, collection_slug], map: "idx_tips_lessons_collection")
}

model user_tips_progress {
  id            String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id       String
  chapter_id    String        @db.Uuid
  status        String        @default("not_started")
  started_at    DateTime?     @db.Timestamptz(6)
  completed_at  DateTime?     @db.Timestamptz(6)
  last_position String?
  updated_at    DateTime      @default(now()) @db.Timestamptz(6)
  chapter       tips_chapters @relation(fields: [chapter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, chapter_id])
  @@index([user_id], map: "idx_user_tips_progress_user")
}

model users {
  id                    String                  @id
  email                 String?                 @unique
  display_name          String?
  photo_url             String?
  native_language       String?
  role                  user_role               @default(student)
  target_band           Decimal?                @db.Decimal(2, 1)
  overall_band          Decimal?                @db.Decimal(2, 1)
  total_practice_time   Int                     @default(0)
  onboarding_complete   Boolean                 @default(false)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  last_active_at        DateTime?               @db.Timestamptz(6)
  phone                 String?                 @unique(map: "uniq_users_phone", where: raw("(phone IS NOT NULL)"))
  password_hash         String?
  is_phone_verified     Boolean                 @default(false)
  exam_date             DateTime?               @db.Date
  avatar                String?
  legal_full_name       String?
  country               String?
  date_of_birth         DateTime?               @db.Date
  exam_type             exam_type?
  academic_background   academic_background?
  has_taken_ielts       Boolean                 @default(false)
  previous_ielts_year   Int?                    @db.SmallInt
  previous_ielts_band   Decimal?                @db.Decimal(2, 1)
  learning_paths        learning_paths[]
  submissions           submissions[]
  test_attempts         test_attempts[]
  uploads               uploads[]
  user_skill_bands      user_skill_bands[]
  user_grammar_progress user_grammar_progress[]
  user_grammar_attempts user_grammar_attempts[]
  user_tips_progress    user_tips_progress[]
  login_events          login_events[]
}

enum lesson_section {
  grammar
  vocab
  tips
}

enum exam_type {
  academic
  general_training
}

enum academic_background {
  ssc_olevels
  hsc_alevels
  diploma
  bachelors
  masters
  phd
  other
}

enum skill_type {
  listening
  reading
  writing
  speaking
}

enum question_type {
  text_input
  single_choice
  multi_choice
  matching
  map_label
}

enum submission_kind {
  single_test
  full_mock
}

enum submission_status {
  pending
  scoring
  scored
  failed
}

enum user_role {
  student
  admin
}

enum grammar_exercise_kind {
  identification
  correction
  essay_edit
  mcq
  production
  gap_fill
}

// One-time codes texted to a phone number via Alpha SMS (api.sms.net.bd),
// used to prove phone ownership before a signup is allowed to complete.
// A row is created per send, hashed (never stored in plaintext), and
// consumed on a successful verify -- src/lib/otp.ts owns all reads/writes
// here, nothing else should touch this table directly.
model phone_otps {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  phone       String
  purpose     String
  otp_hash    String
  expires_at  DateTime  @db.Timestamptz(6)
  attempts    Int       @default(0)
  consumed_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([phone, purpose])
}

model vocabulary {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  word           String
  part_of_speech String?
  meaning        String?
  translation_bn String?

  example     String?
  ielts_usage String?

  past            String?
  past_participle String?
  ing_form        String?
  noun_form       String?
  adjective_form  String?
  adverb_form     String?

  synonyms     String[] @default([])
  antonyms     String[] @default([])
  collocations String[] @default([])

  topic     String?
  lesson_id String? @db.Uuid
  position  Int     @default(0)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  lesson lessons? @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@index([lesson_id])
  @@index([word])
  @@index([topic])
}

+++ b/src/components/lms/CollapsibleItemCard.tsx
@@ -0,0 +1,65 @@
+'use client';
+
+import { useState } from 'react';
+import { ChevronDown } from '../ui/icons';
+
+/**
+ * Shared shell for "list of N similar items" lesson content (vocab words,
+ * error corrections, etc). Was previously duplicated per block type as a
+ * fully-expanded card showing everything at once -- with 20-40 items per
+ * chapter that reads as a wall of near-identical boxes. This version:
+ *   - shows only a compact one-line summary by default
+ *   - expands in place on click (no page navigation, keeps position)
+ *   - has one consistent spacing/border/radius rhythm everywhere it's used
+ *
+ * `accentClassName` lets a specific block type tint the left edge (e.g.
+ * amber for error_matrix) without every item repeating a saturated
+ * full-box background fill.
+ */
+export function CollapsibleItemCard({
+  summary,
+  detail,
+  children,
+  accentClassName = 'border-l-[var(--border-strong)]',
+  defaultOpen = false,
+}: {
+  summary: React.ReactNode;
+  detail?: React.ReactNode;
+  children: React.ReactNode;
+  accentClassName?: string;
+  defaultOpen?: boolean;
+}) {
+  const [open, setOpen] = useState(defaultOpen);
+
+  return (
+    <div
+      className={`rounded-lg border border-[var(--border)] border-l-2 ${accentClassName} bg-[var(--panel-2)]/40 overflow-hidden transition-colors hover:bg-[var(--panel-2)]/60`}
+    >
+      <button
+        type="button"
+        onClick={() => setOpen((v) => !v)}
+        aria-expanded={open}
+        className="w-full flex items-center justify-between gap-3 px-4 py-3 text-left"
+      >
+        <div className="min-w-0 flex-1">
+          <div className="font-display font-semibold text-[var(--text)] text-sm truncate">
+            {summary}
+          </div>
+          {!open && detail && (
+            <div className="text-xs text-[var(--text-faint)] truncate mt-0.5">{detail}</div>
+          )}
+        </div>
+        <ChevronDown
+          size={16}
+          className={`shrink-0 text-[var(--text-faint)] transition-transform ${open ? 'rotate-180' : ''}`}
+        />
+      </button>
+
+      {open && (
+        <div className="px-4 pb-4 pt-1 space-y-2 border-t border-[var(--border)]/50">
+          {children}
+        </div>
+      )}
+    </div>
+  );
+}
